{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "exclude": [
    "duplicates"
  ],
  "ignoreWorkspaces": [
    "apps/desktop"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "scripts/**/*.mjs"
      ],
      "project": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "scripts/**/*.ts",
        "scripts/**/*.mjs"
      ]
    }
  }
}
