{
  "name": "@turboflux/desktop",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "main.mjs",
  "description": "TurboFlux Desktop - open-source Electron workbench",
  "author": "TurboFlux",
  "scripts": {
    "dev": "node ../../scripts/desktop-dev.mjs",
    "build": "vite build --config vite.config.mjs",
    "build:assets": "node ../../scripts/build-desktop-assets.mjs",
    "package:dir": "npm run build && npm run build:assets && electron-builder --config electron-builder.yml --dir",
    "package:mac": "npm run build && npm run build:assets && electron-builder --config electron-builder.yml --mac --arm64",
    "package:win": "npm run build && electron-builder --config electron-builder.yml --win",
    "package:linux": "npm run build && electron-builder --config electron-builder.yml --linux",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config vitest.config.mjs renderer computer browser desktop-contract.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@turboflux/agent-core": "file:../../packages/agent-core",
    "diff": "^9.0.0",
    "highlight.js": "^11.11.1",
    "js-tiktoken": "^1.0.21",
    "marked": "^18.0.4",
    "strip-ansi": "^7.2.0",
    "undici": "^7.29.0",
    "tsx": "^4.22.2"
  },
  "devDependencies": {
    "@types/node": "^22.19.9",
    "@electron/notarize": "^3.1.1",
    "electron": "^39.8.10",
    "electron-builder": "^26.0.12",
    "typescript": "^7.0.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "allowScripts": {
    "electron@39.8.10": true
  }
}
